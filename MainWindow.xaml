<Window x:Class="MacChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مغيّر عنوان MAC — واي فاي" Height="560" Width="620"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- اختيار المحول -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="محول الواي فاي:" VerticalAlignment="Center" Width="120"/>
            <ComboBox x:Name="AdaptersCombo" Width="330" DisplayMemberPath="Name"
                      SelectionChanged="AdaptersCombo_SelectionChanged"/>
            <Button Content="تحديث" Width="80" Margin="8,0,0,0" Click="RefreshButton_Click"/>
        </StackPanel>

        <!-- العنوان الحالي -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="العنوان الحالي:" Width="120" VerticalAlignment="Center"/>
            <TextBlock x:Name="CurrentMacText" Text="—" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- العنوان الأصلي المحفوظ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="العنوان الأصلي:" Width="120" VerticalAlignment="Center"/>
            <TextBlock x:Name="FactoryMacText" Text="غير محفوظ بعد" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <!-- إدخال العنوان الجديد -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="عنوان جديد:" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="NewMacTextBox" Width="230" VerticalContentAlignment="Center"
                     Text="AA:BB:CC:DD:EE:FF"/>
            <Button Content="توليد عشوائي" Width="120" Margin="8,0,0,0" Click="GenerateButton_Click"/>
        </StackPanel>

        <!-- أزرار التنفيذ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,16">
            <Button Content="تطبيق العنوان الجديد" Width="160" Height="34" Click="ApplyButton_Click"/>
            <Button Content="استعادة العنوان الأصلي" Width="160" Height="34" Margin="10,0,0,0" Click="RestoreButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="سجل العمليات:" Margin="0,0,0,4" FontWeight="Bold"/>

        <Border Grid.Row="6" BorderBrush="#CCC" BorderThickness="1">
            <TextBox x:Name="LogTextBox" IsReadOnly="true" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                     Background="#FAFAFA" FontFamily="Consolas" Padding="6"/>
        </Border>
    </Grid>
</Window>
